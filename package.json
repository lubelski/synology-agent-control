{
  "name": "synology-agent-control",
  "version": "0.5.0",
  "description": "Agent-oriented command-line access to Synology DSM and SRM, with curated operations and a raw Web API escape hatch.",
  "type": "module",
  "license": "MIT",
  "author": "Peter Vulgaris",
  "contributors": [
    "William Lubelski"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lubelski/synology-agent-control.git"
  },
  "homepage": "https://github.com/lubelski/synology-agent-control#readme",
  "bugs": "https://github.com/lubelski/synology-agent-control/issues",
  "engines": {
    "node": ">=22"
  },
  "keywords": [
    "synology",
    "dsm",
    "nas",
    "srm",
    "cli"
  ],
  "bin": {
    "synology-agent-control": "dist/cli.js"
  },
  "files": [
    "dist/"
  ],
  "scripts": {
    "clean": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\"",
    "build": "npm run clean && tsc && node -e \"if (process.platform !== 'win32') require('node:fs').chmodSync('dist/cli.js', 0o755)\"",
    "prepare": "npm run build",
    "dev": "tsx src/cli.ts",
    "verify": "tsx src/dev/verify-tools.ts",
    "test": "npm run build && node --import tsx --test --test-force-exit src/*.test.ts src/tools/*.test.ts"
  },
  "dependencies": {
    "otplib": "^12.0.1"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsx": "^4.22.4",
    "typescript": "^5.9.0"
  }
}
